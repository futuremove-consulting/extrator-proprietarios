# Feature Flags
FP_CAPTEI_ENABLED=true
FP_FISGAR_ENABLED=true
FP_EEMOVEL_ENABLED=true
FP_DONODOZAP=true
FP_WHATSAPP=false
FP_CPF=false
FP_EMAIL=false
FP_DRY_RUN=false
FP_DEBUG_MODE=false
FP_VERBOSE=false
FP_RATE_LIMIT=true
FP_RETRY=true
FP_CIRCUIT_BREAKER=true

# Captei
CAPTEI_TOKEN=your_token_here
CAPTEI_USER_KEY=your_user_key_here
CAPTEI_BASE_URL=https://app.captei.com.br

# Fisgar
FISGAR_BASE_URL=https://painel.fisgar.com.br
FISGAR_USERNAME=your_username
FISGAR_PASSWORD=your_password

# EEmovel
EEMOVEL_BASE_URL=https://app.eemovel.com.br
EEMOVEL_USERNAME=your_username
EEMOVEL_PASSWORD=your_password

# Dono do Zap
DONODOZAP_COM_ENABLED=true
DONODOZAP_COM_BR_ENABLED=false

# Rate Limiting (requests por minuto)
RATE_LIMIT_CAPTEI=60
RATE_LIMIT_FISGAR=30
RATE_LIMIT_EEMOVEL=30
RATE_LIMIT_DONODOZAP=30

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_BACKOFF=60

# Timeouts (segundos)
DEFAULT_TIMEOUT=30
CONNECT_TIMEOUT=10
READ_TIMEOUT=30

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
FP_LOGS_DIR=./logs
FP_DATA_DIR=./data
